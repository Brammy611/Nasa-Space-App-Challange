# Required secrets and application configuration
NASA_FIRMS_MAP_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OFFICER_ACCESS_KEY=

# Set this to the Render backend URL. Leave empty when Vercel Services
# supplies PYTHON_PROCESSING_API_URL through its service binding.
PYTHON_PROCESSING_API_URL=

# Render backend defaults
WARM_CACHE=1
LIVE_WINDOWS=24h,7d,30d
FIRE_REPORTS_DB_PATH=/var/data/reports.sqlite
FIRE_REPORT_PHOTOS_DIR=/var/data/report_photos

# Optional backend overrides
FIRE_HISTORICAL_DB_PATH=
ADMIN_BOUNDARIES_DB=
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_S=600
